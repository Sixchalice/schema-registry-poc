# cp .env.example .env, then edit. All settings: acl_api/settings.py
ACL_API_USER=acl-admin
ACL_API_PASSWORD=change-me
# Host port (compose only)
ACL_API_PORT=8087
# Seconds before a single sr-acl-cli run is killed (-> 504)
ACL_API_CLI_TIMEOUT=60
# Unfinished writes allowed (running + queued); more get 503 + Retry-After
ACL_API_MAX_PENDING_WRITES=200
# Seconds to collect concurrent writes before each CLI call, so a burst is merged into one call
ACL_API_WRITE_BATCH_WINDOW=0.05
ACL_API_LOG_LEVEL=INFO
