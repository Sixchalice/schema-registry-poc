# cp .env.example .env, then edit
ACL_SERVICE_USER=acl-admin
ACL_SERVICE_PASSWORD=change-me
ACL_API_PORT=8087
# Seconds before a single sr-acl-cli run is killed (-> 504)
SR_ACL_CLI_TIMEOUT=60
# Writes waiting for the write lock beyond this get 503 + Retry-After instead of queueing
SR_ACL_MAX_PENDING_WRITES=20
