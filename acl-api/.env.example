# cp .env.example .env, then edit. All settings: acl_api/settings.py
ACL_API_USER=acl-admin
ACL_API_PASSWORD=change-me
# Host port (compose only)
ACL_API_PORT=8087
# Seconds before a single sr-acl-cli run is killed (-> 504)
ACL_API_CLI_TIMEOUT=60
# Writes allowed to wait (running + queued); more get 503 + Retry-After
ACL_API_MAX_PENDING_WRITES=20
ACL_API_LOG_LEVEL=INFO
